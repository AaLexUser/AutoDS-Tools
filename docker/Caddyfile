{
	# Private / lab hostnames are not eligible for public CA certs (Let's Encrypt).
	# Serve HTTP only on :80 (mapped to host :8000 in docker-compose).
	auto_https off
}

:80 {
	basic_auth {
		{$BASIC_AUTH_USERNAME} {$BASIC_AUTH_PASSWORD_HASH}
	}

	@backend path /api/* /health
	@install_stream path /api/sessions/*/install/stream
	@uploads path /api/sessions/*/dataset /api/sessions/*/dataset/chunk

	# Long-running file uploads: avoid proxy timeouts and response compression.
	handle @uploads {
		reverse_proxy autods-server:8000 {
			flush_interval -1
			transport http {
				read_timeout 24h
				write_timeout 24h
				response_header_timeout 24h
			}
		}
	}

	# Keep install streams uncompressed so proxies do not buffer NDJSON chunks.
	handle @install_stream {
		reverse_proxy autods-server:8000
	}

	handle @backend {
		encode gzip zstd
		reverse_proxy autods-server:8000
	}

	encode gzip zstd
	reverse_proxy autods-frontend:3000
}
